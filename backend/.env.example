# At least one provider key is required. Groq is attempted first when both exist.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

DATABASE_URL=postgresql://postgres:password@localhost:5432/examgpt
APP_URL=http://localhost:5173
LLM_TIMEOUT_SECONDS=45
