# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ExamGPT — Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
#  Copy this file to .env and fill in the values.
#
#    cp .env.example .env
#

# Groq Cloud API key — get one at https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here

# Database connection string
# For local SQLite (simplest):
DATABASE_URL=sqlite:///./examgpt.db
# For PostgreSQL via Docker Compose:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/examgpt_db
