# Optional provider keys. Gemini is attempted first, then Groq.
# If both providers fail, pasted text is used for local extraction and
# best-effort DuckDuckGo search; no LLM key is required for that fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DATABASE_URL=postgresql://postgres:password@localhost:5432/examgpt
APP_URL=http://localhost:5173
LLM_TIMEOUT_SECONDS=30
